
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Administration | MINZOTO Lab</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f5f5f3;color:#202020}
header{background:#171717;color:white;padding:22px}
header strong{font-size:22px}
header span{color:#e7b928}
header p{color:#bbb;margin-bottom:0}
main{max-width:950px;margin:auto;padding:22px}
h1{font-size:27px}
.muted{color:#777;font-size:14px;line-height:1.5}
nav{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0}
button{border:0;border-radius:7px;padding:12px 15px;background:#222;color:white;font-weight:bold;cursor:pointer}
nav button{background:white;color:#333;border:1px solid #ddd}
nav button.active,.gold{background:#e7b928;color:#171717}
.panel{background:white;border:1px solid #e6e6e6;border-radius:12px;padding:18px;margin:14px 0}
.stat{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.number{font-size:26px;font-weight:bold;margin-top:8px}
label{display:block;font-size:14px;font-weight:bold;margin:14px 0 6px}
input,textarea,select{width:100%;padding:12px;border:1px solid #ccc;border-radius:7px;font:inherit;background:white}
textarea{min-height:75px}
.item{border-bottom:1px solid #eee;padding:15px 0}
.item:last-child{border:0}
.item strong{display:block;margin-bottom:6px}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.small{padding:8px 10px;font-size:12px}
.danger{background:#f8e5e5;color:#8d2222}
.hidden{display:none}
.notice{background:#fff6d8;padding:13px;border-radius:8px;font-size:13px;line-height:1.5}
@media(max-width:520px){main{padding:15px}.stat{grid-template-columns:1fr 1fr}.panel{padding:14px}}
</style>
</head>
<body>
<header>
  <strong>MINZOTO <span>Lab</span></strong>
  <p>Espace de gestion du studio créatif</p>
</header>
<main>
  <h1>Tableau de bord</h1>
  <p class="muted">Gère ici tes projets, tes services et tes tarifs.</p>

  <div class="notice">
    Démonstration en cours : cette page n'est pas encore protégée par un mot de passe et les changements ne sont pas encore synchronisés avec le site public. N'y mets aucune information confidentielle.
  </div>

  <div class="stat">
    <div class="panel"><div class="muted">Projets</div><div class="number" id="projectCount">2</div></div>
    <div class="panel"><div class="muted">Services</div><div class="number" id="serviceCount">3</div></div>
  </div>

  <nav>
    <button class="active" onclick="showTab('projects',this)">Mes projets</button>
    <button onclick="showTab('prices',this)">Mes tarifs</button>
    <button onclick="showTab('services',this)">Mes services</button>
  </nav>

  <section id="projects">
    <div class="panel">
      <h2>Ajouter un projet</h2>
      <label for="projectName">Nom du projet</label>
      <input id="projectName" placeholder="Ex. Logo pour une entreprise">
      <label for="projectCategory">Catégorie</label>
      <select id="projectCategory">
        <option>Logo</option><option>Affiche</option>
        <option>Portrait numérique</option><option>Retouche photo</option>
        <option>Autre création</option>
      </select>
      <label for="projectDescription">Description</label>
      <textarea id="projectDescription" placeholder="Décris brièvement le projet"></textarea>
      <button class="gold" onclick="addProject()">Ajouter le projet</button>
    </div>
    <div class="panel">
      <h2>Mes projets enregistrés</h2>
      <div id="projectList"></div>
    </div>
  </section>

  <section id="prices" class="hidden">
    <div class="panel">
      <h2>Modifier les tarifs</h2>
      <p class="muted">Modifie les prix de démonstration, puis enregistre.</p>
      <label for="logoPrice">Création de logo</label>
      <input id="logoPrice" value="Prix sur demande">
      <label for="posterPrice">Affiche publicitaire</label>
      <input id="posterPrice" value="Prix sur demande">
      <label for="portraitPrice">Portrait numérique</label>
      <input id="portraitPrice" value="Prix sur demande">
      <button class="gold" onclick="savePrices()">Enregistrer les tarifs</button>
      <p id="priceMessage" class="muted"></p>
    </div>
  </section>

  <section id="services" class="hidden">
    <div class="panel">
      <h2>Mes services</h2>
      <div id="serviceList"></div>
      <label for="newService">Ajouter un service</label>
      <input id="newService" placeholder="Ex. Design de carte de visite">
      <button class="gold" onclick="addService()">Ajouter le service</button>
    </div>
  </section>
</main>

<script>
const defaults = [
  {name:"Identité visuelle",category:"Logo",description:"Création de logos personnalisés"},
  {name:"Affiches et flyers",category:"Affiche",description:"Supports publicitaires créatifs"}
];
let projects = defaults.slice();
let services = ["Création de logo","Affiche publicitaire","Portrait numérique"];

function showTab(id,button){
  ["projects","prices","services"].forEach(x=>document.getElementById(x).classList.toggle("hidden",x!==id));
  document.querySelectorAll("nav button").forEach(b=>b.classList.remove("active"));
  button.classList.add("active");
}
function renderProjects(){
  document.getElementById("projectCount").textContent=projects.length;
  document.getElementById("projectList").innerHTML=projects.length?projects.map((p,i)=>
    `<div class="item"><div class="row"><strong>${escapeText(p.name)}</strong><button class="small danger" onclick="deleteProject(${i})">Supprimer</button></div><div class="muted">${escapeText(p.category)} — ${escapeText(p.description)}</div></div>`
  ).join(""):"<p class='muted'>Aucun projet pour le moment.</p>";
}
function escapeText(s){
  return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function addProject(){
  const name=document.getElementById("projectName").value.trim();
  if(!name){alert("Entre le nom du projet.");return;}
  projects.push({name,category:document.getElementById("projectCategory").value,description:document.getElementById("projectDescription").value.trim()||"Aucune description"});
  document.getElementById("projectName").value="";
  document.getElementById("projectDescription").value="";
  renderProjects();
}
function deleteProject(i){projects.splice(i,1);renderProjects();}
function savePrices(){
  document.getElementById("priceMessage").textContent="Tarifs modifiés dans cette démonstration. La sauvegarde permanente sera ajoutée plus tard.";
}
function renderServices(){
  document.getElementById("serviceCount").textContent=services.length;
  document.getElementById("serviceList").innerHTML=services.map((s,i)=>
    `<div class="item row"><strong>${escapeText(s)}</strong><button class="small danger" onclick="deleteService(${i})">Supprimer</button></div>`
  ).join("");
}
function addService(){
  const input=document.getElementById("newService");
  const value=input.value.trim();
  if(!value)return;
  services.push(value);input.value="";renderServices();
}
function deleteService(i){services.splice(i,1);renderServices();}
renderProjects();renderServices();
</script>
</body>
</html>
